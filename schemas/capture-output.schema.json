{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roomfield.local/schemas/capture-output.schema.json",
  "title": "Roomfield capture output contract (prototype)",
  "type": "object",
  "required": ["schema_version", "capture_id", "created_at", "input_tier", "processing_status", "limitations", "property", "measurements", "benchmark", "raw_inputs"],
  "properties": {
    "schema_version": { "const": "0.2.0-experimental" },
    "capture_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "input_tier": { "enum": ["photos", "video", "lidar"] },
    "processing_status": { "enum": ["not_measured", "partial_geometry_unvalidated"] },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "pipeline_stages": { "type": ["object", "null"] },
    "property": {
      "type": "object",
      "required": ["rooms", "stitched_plan", "drift_handling"],
      "properties": {
        "rooms": { "type": "array", "items": { "type": "object" } },
        "stitched_plan": { "type": "object", "required": ["status", "render_path", "footprint_m2", "footprint_interval_m2"], "properties": { "status": { "enum": ["not_measured", "geometry_preview_only"] }, "render_path": { "type": ["string", "null"] }, "footprint_m2": { "type": ["number", "null"] }, "footprint_interval_m2": { "type": ["array", "null"], "items": { "type": "number" } }, "observed_floor_hull_m2": { "type": ["number", "null"] } } },
        "drift_handling": { "type": "object", "required": ["method", "ablation"], "properties": { "method": { "type": ["string", "null"] }, "ablation": { "const": "not_run" } } }
      }
    },
    "measurements": {
      "type": "object",
      "required": ["wall_lengths", "ceiling_heights", "floor_areas", "openings", "damage_regions", "concealed_damage_flags", "scope_line_items"],
      "properties": {
        "wall_lengths": { "type": "array" },
        "ceiling_heights": { "type": "array" },
        "floor_areas": { "type": "array" },
        "openings": { "type": "array" },
        "damage_regions": { "type": "array" },
        "concealed_damage_flags": { "type": "array" },
        "scope_line_items": { "type": "array" }
      }
    },
    "benchmark": { "type": "object", "required": ["gate_status", "ground_truth", "repeatability", "incumbent_comparison"], "properties": { "gate_status": { "const": "not_run" }, "ground_truth": { "type": ["object", "null"] }, "repeatability": { "type": ["object", "null"] }, "incumbent_comparison": { "type": ["object", "null"] } } },
    "raw_inputs": { "type": "array", "items": { "type": "object", "required": ["path", "original_name", "bytes"] } }
  }
}